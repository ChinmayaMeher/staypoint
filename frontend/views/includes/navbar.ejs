<nav class="navbar">
  <div class="navbar-container">
    <a href="/listings" class="navbar-brand">
    <span class="brand-icon">⬡</span>
    <span class="brand-text">Stay<strong>Point</strong></span>
  </a>

  <div class="navbar-search">
    <form action="/listings" method="GET" class="search-bar-global">
      <input type="text" name="q" placeholder="Search destinations..." class="search-input-global">
      <button type="submit" class="search-btn-global">
        <i class="fa fa-search"></i>
      </button>
    </form>
  </div>

  <div class="navbar-links">
    <% if (currUser) { %>
      <a href="/notifications" class="nav-link nav-bell <%= unreadNotificationCount > 0 ? 'has-unread' : '' %>">
        <i class="fa fa-bell"></i>
        <% if (unreadNotificationCount > 0) { %>
          <span class="bell-badge"><%= unreadNotificationCount %></span>
        <% } %>
      </a>
      <div class="user-dropdown-container">
        <button class="user-dropdown-btn" id="userDropdownBtn">
          <i class="fa fa-bars"></i>
          <i class="fa fa-user-circle"></i>
        </button>
        <div class="user-dropdown-menu" id="userDropdownMenu">
          <div class="dropdown-header">
            <strong><%= currUser.username %></strong>
          </div>
          <hr>
          <a href="/profile" class="dropdown-item"><i class="fa fa-user"></i> Profile</a>
          <a href="/bookings" class="dropdown-item"><i class="fa fa-suitcase"></i> My Bookings</a>
          <a href="/wishlist" class="dropdown-item"><i class="fa fa-heart"></i> Wishlist</a>
          <hr>
          <% if (currUser.role === 'host' || currUser.role === 'admin') { %>
            <a href="/listings/new" class="dropdown-item"><i class="fa fa-plus-circle"></i> List Your Room</a>
            <form action="/profile/switch-role" method="POST" class="dropdown-form">
              <input type="hidden" name="_token" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <button type="submit" class="dropdown-item"><i class="fa fa-exchange-alt"></i> Switch to Guest</button>
            </form>
          <% } else { %>
            <form action="/profile/switch-role" method="POST" class="dropdown-form">
              <input type="hidden" name="_token" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <button type="submit" class="dropdown-item"><i class="fa fa-exchange-alt"></i> Become a Host</button>
            </form>
          <% } %>
          <hr>
          <a href="/logout" class="dropdown-item"><i class="fa fa-sign-out-alt"></i> Logout</a>
        </div>
      </div>
    <% } else { %>
      <a href="/login" class="nav-link">Login</a>
      <a href="/signup" class="btn btn-primary">Sign Up</a>
    <% } %>
    <button id="themeToggle" class="btn btn-ghost" style="font-size: 1.2rem; padding: 5px 10px; margin-left: 10px;" title="Toggle dark mode">
      <i class="fa fa-moon"></i>
    </button>
  </div>

  <button class="mobile-menu-btn" id="menuBtn">
    <div class="hamburger-animated">
      <span></span>
      <span></span>
      <span></span>
    </div>
  </button>

  <div class="mobile-menu" id="mobileMenu">
    <% if (currUser) { %>
      <a href="/notifications" style="position: relative; display: inline-block; width: max-content;">
        Notifications
        <% if (unreadNotificationCount > 0) { %>
          <span style="background-color: #e74c3c; color: white; border-radius: 50%; padding: 2px 8px; font-size: 12px; font-weight: bold; margin-left: 5px;"><%= unreadNotificationCount %></span>
        <% } %>
      </a>
      <span class="nav-user"><i class="fa fa-user-circle"></i> <%= currUser.username %></span>
      <% if (currUser.role === 'host' || currUser.role === 'admin') { %>
        <a href="/listings/new">+ List Your Room</a>
        <form action="/profile/switch-role" method="POST" style="margin: 10px 0;">
          <input type="hidden" name="_token" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <button type="submit" style="background:none; border:none; color:inherit; font:inherit; cursor:pointer; padding:0;">Switch to Guest</button>
        </form>
      <% } else { %>
        <form action="/profile/switch-role" method="POST" style="margin: 10px 0;">
          <input type="hidden" name="_token" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <button type="submit" style="background:none; border:none; color:inherit; font:inherit; cursor:pointer; padding:0;">Become a Host</button>
        </form>
      <% } %>
      <a href="/logout">Logout</a>
    <% } else { %>
      <a href="/login">Login</a>
      <a href="/signup">Sign Up</a>
    <% } %>
      <button id="mobileThemeToggle" style="background:none; border:none; color:inherit; font:inherit; cursor:pointer; padding:0; margin-top: 10px; text-align: left;">
        <i class="fa fa-moon"></i> Toggle Dark Mode
      </button>
    </div>
  </div>
</nav>
